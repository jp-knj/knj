---
interface Props {
    label?: string;
    border?: "solid" | "solid-orange" | null;
    start?: number;
    span?: number;
    smallStart?: number;
    smallSpan?: number;
}

const { label, border, start, span, smallStart, smallSpan } = Astro.props;

const column =
    span != null
        ? `${start ?? 1} / span ${span}`
        : start != null
          ? `${start} / -1`
          : "1 / -1";

const columnSmall =
    smallSpan != null
        ? `${smallStart ?? 1} / span ${smallSpan}`
        : smallStart != null
          ? `${smallStart} / -1`
          : null;

const styleParts = [`--section-column: ${column}`];
if (columnSmall) styleParts.push(`--section-column-small: ${columnSmall}`);
const style = styleParts.join("; ");
---

<section data-border={border} style={style}>
    {label && <span class="label">{label}</span>}
    <slot />
</section>

<style>
    section {
        grid-column: var(--section-column, 1 / -1);
        display: grid;
        grid-template-columns: subgrid;
        column-gap: inherit;
        row-gap: var(--space-48);
        position: relative;
        z-index: 1;
        padding-block: var(--grid-padding-y);
    }

    @container (width <= 40rem) {
        section {
            grid-column: var(--section-column-small, 1 / -1);
        }
    }

    @container (width <= 26.25rem) {
        section {
            grid-column: 1 / -1;
        }
    }

    section[data-border="solid"] {
        padding-inline: var(--grid-padding-x);
        border: 2px solid var(--grid-rule-major);
    }

    section[data-border="solid-orange"] {
        --accent-warm: #d4752c;

        padding-inline: var(--grid-padding-x);
        border: 2px solid var(--accent-warm);
    }

    .label {
        grid-column: 1 / -1;
        font-size: var(--font-size-18);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--foreground-muted);
        opacity: 0.55;
    }

    @container (width <= 55rem) {
        section {
            padding-inline: var(--space-24);
        }
    }

    @supports not (grid-template-columns: subgrid) {
        section {
            display: contents;
        }

        .label {
            grid-column: 1 / -1;
        }
    }
</style>
