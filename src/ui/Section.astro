---
import typography from "../styles/typography.module.css";

interface Props {
    label?: string;
}

const { label } = Astro.props;
---

<section>
    {label && <span class:list={["label", typography.metaText]}>{label}</span>}
    <slot />
</section>

<style>
    section {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
        column-gap: inherit;
        row-gap: clamp(0.5rem, 1vw, 0.875rem);
        position: relative;
        z-index: 1;
        border: 1.5px solid var(--grid-rule-major);
        padding-inline: var(--grid-padding-x);
        padding-block: var(--grid-padding-y);
    }

    .label {
        grid-column: 1 / -1;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--foreground-muted);
        opacity: 0.55;
        margin-block-end: 0.25rem;
    }

    @supports not (grid-template-columns: subgrid) {
        section {
            display: contents;
        }

        .label {
            grid-column: 1 / -1;
        }
    }
</style>
