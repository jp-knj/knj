---
interface Props {
  as?: string;
}

const { as: Tag = "div" } = Astro.props;
---

<Tag class="grid">
  <slot />
</Tag>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), 1fr);
    gap: var(--grid-row-gap) var(--grid-gutter);
    position: relative;
  }
</style>
