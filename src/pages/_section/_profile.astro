---
import ScrambleHeading from "../../ui/scramble-heading.astro";
---

<section id="profile" class="content-section profile" data-profile>
    <div class="profile-heading">
        <ScrambleHeading text="Profile" class="heading-2" />
    </div>

    <div class="profile-body">
        <p class="eyebrow">Kenji Wu / Design Engineer</p>
        <p class="lead">
            I work between design systems, frontend platforms, information
            design, and open source.
        </p>
        <p>
            Based in Tokyo. I write and build for the web in Japanese and
            English, with a focus on Astro, content systems, and interface
            design.
        </p>
    </div>

    <ul class="profile-files" aria-label="Profile details">
        <li class="profile-file" data-profile-file>
            <button
                class="profile-file__handle"
                type="button"
                aria-label="Move now.txt. Use the arrow keys for precise movement."
                data-profile-file-handle
            >
                <span class="file-name">now.txt</span>
                <span class="window-controls" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </span>
            </button>
            <div class="profile-file__content">
                <span class="file-path">/profile/now.txt</span>
                <p>whoami kenji design engineer</p>
                <span class="file-type">TXT</span>
            </div>
        </li>
        <li class="profile-file" data-profile-file>
            <button
                class="profile-file__handle"
                type="button"
                aria-label="Move principle.txt. Use the arrow keys for precise movement."
                data-profile-file-handle
            >
                <span class="file-name">principle.txt</span>
                <span class="window-controls" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </span>
            </button>
            <div class="profile-file__content">
                <span class="file-path">/profile/principle.txt</span>
                <p>make tools readable, durable, and kind to maintain</p>
                <span class="file-type">TXT</span>
            </div>
        </li>
        <li class="profile-file" data-profile-file>
            <button
                class="profile-file__handle"
                type="button"
                aria-label="Move focus.json. Use the arrow keys for precise movement."
                data-profile-file-handle
            >
                <span class="file-name">focus.json</span>
                <span class="window-controls" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </span>
            </button>
            <div class="profile-file__content">
                <span class="file-path">/profile/focus.json</span>
                <p>interface systems content open source</p>
                <span class="file-type">JSON</span>
            </div>
        </li>
    </ul>
</section>

<style>
    .content-section {
        --section-gap: 3rem;
        --section-padding: 3rem;

        box-sizing: border-box;
        display: grid;
        gap: var(--section-gap);
        min-block-size: 100%;
        padding: var(--section-padding);
        border-block-end: 1px solid var(--color-ink);
    }

    .profile {
        position: relative;
        isolation: isolate;
        display: grid;
        overflow: hidden;
    }

    .profile-heading,
    .profile-body,
    .profile-files {
        position: relative;
        z-index: 1;
        min-inline-size: 0;
    }

    .eyebrow {
        margin-block-start: 1rem;
        font-size: var(--font-size-16);
        line-height: 1.5;
    }

    .profile-body {
        display: grid;
        align-content: start;
        gap: 1rem;
        font-size: var(--font-size-20);
        line-height: 1.55;
    }

    .profile-body p {
        margin: 0;
    }

    .lead {
        font-size: var(--font-size-24);
        line-height: 1.35;
    }

    .profile-files {
        position: relative;
        z-index: 1;
        grid-column: 1 / -1;
        display: block;
        min-block-size: 38rem;
        margin: 3rem 0 0;
        padding: 0;
        list-style: none;
    }

    .profile-file {
        --file-x: 0rem;
        --file-y: 0rem;
        --file-accent: var(--color-pink);

        position: absolute;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        margin-block-start: 0.625rem;
        border: 1px solid var(--color-ink);
        border-radius: 0 0.25rem 0.25rem;
        background: var(--color-paper);
        box-shadow: 0.25rem 0.25rem 0 var(--file-accent);
        font-size: var(--font-size-16);
        line-height: 1.45;
        transform: translate3d(var(--file-x), var(--file-y), 0);
        will-change: transform;
    }

    .profile-file:nth-child(1) {
        inset-block-start: 3.25rem;
        inset-inline-start: 1.5%;
        z-index: 1;
        inline-size: clamp(16rem, 32%, 24rem);
        min-block-size: 14rem;
    }

    .profile-file:nth-child(2) {
        --file-accent: var(--color-cyan);

        inset-block-start: 13.5rem;
        inset-inline-start: 26%;
        z-index: 3;
        inline-size: clamp(19rem, 44%, 30rem);
        min-block-size: 20rem;
    }

    .profile-file:nth-child(3) {
        --file-accent: var(--color-green);

        inset-block-start: 0.75rem;
        inset-inline-end: 2.5%;
        z-index: 2;
        inline-size: clamp(14rem, 29%, 21rem);
        min-block-size: 12.5rem;
    }

    .profile-file.is-dragging {
        box-shadow: 0.4rem 0.4rem 0 var(--file-accent);
        cursor: grabbing;
        user-select: none;
    }

    .profile-file__handle {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-inline-size: 0;
        min-block-size: 2.75rem;
        padding: 0.625rem 0.75rem;
        border: 0;
        border-block-end: 1px solid var(--file-accent);
        background: var(--color-paper);
        box-shadow: inset 0 0.25rem 0 var(--file-accent);
        color: var(--color-ink);
        font: inherit;
        text-align: start;
        cursor: grab;
        touch-action: none;
    }

    .profile-file__handle::before {
        position: absolute;
        inset-block-start: -0.625rem;
        inset-inline-start: -0.0625rem;
        inline-size: clamp(5rem, 46%, 8rem);
        block-size: 0.625rem;
        border: 1px solid var(--color-ink);
        border-block-end: 0;
        border-radius: 0.35rem 0.35rem 0 0;
        background: var(--file-accent);
        content: "";
    }

    .profile-file__handle:focus-visible {
        outline: 0.1875rem solid var(--color-yellow);
        outline-offset: -0.375rem;
    }

    .profile-file__handle:active {
        cursor: grabbing;
    }

    .file-name {
        min-inline-size: 0;
        overflow: hidden;
        color: var(--color-ink);
        font-weight: 500;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .window-controls {
        display: flex;
        flex: none;
        gap: 0.3rem;
        margin-inline-start: auto;
    }

    .window-controls span {
        inline-size: 0.45rem;
        block-size: 0.45rem;
        border: 1px solid var(--color-ink);
        border-radius: 50%;
        background: var(--color-pink);
    }

    .window-controls span:nth-child(2) {
        background: var(--color-cyan);
    }

    .window-controls span:nth-child(3) {
        background: var(--color-green);
    }

    .window-controls span:nth-child(4) {
        background: var(--color-yellow);
    }

    .profile-file__content {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: 0.875rem;
        min-inline-size: 0;
        padding: 1rem;
    }

    .profile-file__content p {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .file-path {
        color: var(--foreground-muted);
        font-size: 0.75rem;
        overflow-wrap: anywhere;
    }

    .file-type {
        justify-self: start;
        padding: 0.125rem 0.35rem;
        border: 1px solid var(--file-accent);
        color: var(--color-ink);
        font-size: 0.6875rem;
        line-height: 1.2;
    }

    @media (width <= 56rem) {
        .content-section {
            --section-gap: 2rem;
            --section-padding: clamp(1.25rem, 5vw, 3rem);
        }

        .profile-files {
            min-block-size: 43rem;
            margin-block-start: 2rem;
        }

        .profile-file:nth-child(1) {
            inset-block-start: 1.5rem;
            inset-inline-start: 0;
            inline-size: 68%;
        }

        .profile-file:nth-child(2) {
            inset-block-start: 14rem;
            inset-inline: auto 0;
            inline-size: 76%;
            min-block-size: 18rem;
        }

        .profile-file:nth-child(3) {
            inset-block-start: 31rem;
            inset-inline: 6% auto;
            inline-size: 63%;
        }
    }

    @media (width <= 36rem) {
        .profile-files {
            min-block-size: 44rem;
        }

        .profile-file:nth-child(1) {
            inline-size: 84%;
        }

        .profile-file:nth-child(2) {
            inset-block-start: 14.5rem;
            inline-size: 92%;
        }

        .profile-file:nth-child(3) {
            inset-block-start: 31.5rem;
            inset-inline-start: 4%;
            inline-size: 75%;
        }
    }
</style>

<script>
    const profile = document.querySelector("[data-profile]");

    if (
        profile instanceof HTMLElement &&
        profile.dataset.dragInitialized !== "true"
    ) {
        profile.dataset.dragInitialized = "true";

        const cards = Array.from(
            profile.querySelectorAll("[data-profile-file]"),
        ).filter((card): card is HTMLElement => card instanceof HTMLElement);
        let topLayer = cards.length;

        const readPosition = (card: HTMLElement) => ({
            x: Number.parseFloat(card.dataset.x ?? "0"),
            y: Number.parseFloat(card.dataset.y ?? "0"),
        });

        const constrainPosition = (card: HTMLElement, x: number, y: number) => {
            const profileRect = profile.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();
            const current = readPosition(card);
            const inset = 1;
            const baseLeft = cardRect.left - current.x;
            const baseTop = cardRect.top - current.y;
            const baseRight = cardRect.right - current.x;
            const baseBottom = cardRect.bottom - current.y;
            const minX = profileRect.left + inset - baseLeft;
            const maxX = profileRect.right - inset - baseRight;
            const minY = profileRect.top + inset - baseTop;
            const maxY = profileRect.bottom - inset - baseBottom;
            const clamp = (value: number, min: number, max: number) =>
                min <= max ? Math.min(Math.max(value, min), max) : min;

            return {
                x: clamp(x, minX, maxX),
                y: clamp(y, minY, maxY),
            };
        };

        const setPosition = (card: HTMLElement, x: number, y: number) => {
            const next = constrainPosition(card, x, y);

            card.dataset.x = String(next.x);
            card.dataset.y = String(next.y);
            card.style.setProperty("--file-x", `${next.x}px`);
            card.style.setProperty("--file-y", `${next.y}px`);
        };

        const bringToFront = (card: HTMLElement) => {
            topLayer += 1;
            card.style.zIndex = String(topLayer);
        };

        for (const card of cards) {
            const handle = card.querySelector("[data-profile-file-handle]");

            if (!(handle instanceof HTMLButtonElement)) {
                continue;
            }

            let drag:
                | {
                      pointerId: number;
                      startX: number;
                      startY: number;
                      cardX: number;
                      cardY: number;
                  }
                | undefined;

            const finishDrag = (event: PointerEvent) => {
                if (drag?.pointerId !== event.pointerId) {
                    return;
                }

                card.classList.remove("is-dragging");
                drag = undefined;
            };

            handle.addEventListener("pointerdown", (event) => {
                if (event.button !== 0) {
                    return;
                }

                const current = readPosition(card);

                drag = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    cardX: current.x,
                    cardY: current.y,
                };

                bringToFront(card);
                card.classList.add("is-dragging");
                handle.focus({ preventScroll: true });
                handle.setPointerCapture(event.pointerId);
                event.preventDefault();
            });

            handle.addEventListener("pointermove", (event) => {
                if (drag?.pointerId !== event.pointerId) {
                    return;
                }

                setPosition(
                    card,
                    drag.cardX + event.clientX - drag.startX,
                    drag.cardY + event.clientY - drag.startY,
                );
                event.preventDefault();
            });

            handle.addEventListener("pointerup", finishDrag);
            handle.addEventListener("pointercancel", finishDrag);
            handle.addEventListener("lostpointercapture", finishDrag);

            handle.addEventListener("keydown", (event) => {
                const direction = {
                    ArrowLeft: [-1, 0],
                    ArrowRight: [1, 0],
                    ArrowUp: [0, -1],
                    ArrowDown: [0, 1],
                }[event.key];

                if (!direction) {
                    return;
                }

                const current = readPosition(card);
                const distance = event.shiftKey ? 24 : 8;

                bringToFront(card);
                setPosition(
                    card,
                    current.x + direction[0] * distance,
                    current.y + direction[1] * distance,
                );
                event.preventDefault();
            });
        }

        let resizeFrame = 0;

        window.addEventListener("resize", () => {
            window.cancelAnimationFrame(resizeFrame);
            resizeFrame = window.requestAnimationFrame(() => {
                for (const card of cards) {
                    const current = readPosition(card);

                    setPosition(card, current.x, current.y);
                }
            });
        });
    }
</script>
