---
import ScrambleHeading from "../../ui/scramble-heading.astro";
---

<section id="profile" class="content-section profile">
    <div class="profile-heading">
        <ScrambleHeading text="Profile" class="heading-2" />
        <p class="eyebrow">Kenji Wu / Design Engineer</p>
    </div>

    <div class="profile-body">
        <p class="lead">
            I work between design systems, frontend platforms, information
            design, and open source.
        </p>
        <p>
            Based in Tokyo. I write and build for the web in Japanese and
            English, with a focus on Astro, content systems, and interface
            design.
        </p>
    </div>

    <ul class="profile-files" aria-label="Profile details">
        <li>
            <span class="file-name">now.txt</span>
            <span>whoami kenji design engineer</span>
        </li>
        <li>
            <span class="file-name">principle.txt</span>
            <span>make tools readable, durable, and kind to maintain</span>
        </li>
        <li>
            <span class="file-name">focus.json</span>
            <span>interface systems content open source</span>
        </li>
    </ul>
</section>

<style>
    .content-section {
        --section-gap: 3rem;
        --section-padding: 3rem;

        box-sizing: border-box;
        display: grid;
        gap: var(--section-gap);
        min-block-size: 100%;
        padding: var(--section-padding);
        border-block-end: 1px solid var(--color-ink);
    }

    .profile {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
    }

    .profile-heading,
    .profile-body,
    .profile-files {
        min-inline-size: 0;
    }

    .eyebrow {
        margin-block-start: 1rem;
        font-size: var(--font-size-16);
        line-height: 1.5;
    }

    .profile-body {
        display: grid;
        align-content: start;
        gap: 1rem;
        font-size: var(--font-size-20);
        line-height: 1.55;
    }

    .profile-body p {
        margin: 0;
    }

    .lead {
        font-size: var(--font-size-24);
        line-height: 1.35;
    }

    .profile-files {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .profile-files li {
        display: grid;
        align-content: start;
        gap: 1.5rem;
        min-block-size: 10rem;
        padding: 1rem;
        border: 1px solid var(--color-ink);
        font-size: var(--font-size-16);
        line-height: 1.45;
    }

    .file-name {
        color: var(--foreground-muted);
    }

</style>
