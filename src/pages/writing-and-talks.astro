---
import Layout from "../layouts/layout.astro";
import Grid from "../ui/grid.astro";
import GridRules from "../ui/grid-rules.astro";
import Section from "../ui/section.astro";
import Cell from "../ui/cell.astro";
import { writingAndTalks } from "../data/writing-and-talks";
---

<Layout title="Writing & Talks | Kenji">
    <Grid>
        <GridRules />
        <Section>
            <Cell start={1} span={8} smallSpan={4}>
                <h1 class="page-title">Writing &amp; Talks</h1>
            </Cell>
        </Section>

        <Section>
            <Cell start={1} span={8} smallSpan={4}>
                <ul class="entries">
                    {
                        writingAndTalks.map((entry) => (
                            <li class="entry">
                                {entry.image && (
                                    <img
                                        class="entry-thumbnail"
                                        src={entry.image}
                                        alt=""
                                        width="160"
                                        height="100"
                                        loading="lazy"
                                    />
                                )}
                                <div class="entry-body">
                                    <span class="entry-meta">
                                        {entry.year} · {entry.month} ·{" "}
                                        {entry.type}
                                    </span>
                                    <a
                                        class="entry-link"
                                        href={entry.link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {entry.title}
                                    </a>
                                    {entry.description && (
                                        <p class="entry-description">
                                            {entry.description}
                                        </p>
                                    )}
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </Cell>
        </Section>
    </Grid>
</Layout>

<style>
    .page-title {
        font-family: Syne, sans-serif;
        font-size: var(--font-size-72);
        font-weight: 700;
        line-height: 0.95;
        color: var(--foreground);
        letter-spacing: -0.02em;
    }

    .entries {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-32);
    }

    .entry {
        display: flex;
        align-items: start;
        gap: var(--space-24);
    }

    .entry:not(:last-child) {
        border-block-end: 1px solid var(--grid-rule-major);
        padding-block-end: var(--space-16);
    }

    .entry-thumbnail {
        inline-size: 8rem;
        block-size: 5rem;
        object-fit: cover;
        border-radius: 0.25rem;
        flex-shrink: 0;
    }

    .entry-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        min-inline-size: 0;
    }

    .entry-meta {
        font-family: "DM Mono", monospace;
        font-size: var(--font-size-18);
        color: var(--foreground-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .entry-link {
        font-size: var(--font-size-22);
        color: var(--foreground-secondary);
        line-height: 1.4;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .entry-link:hover,
    .entry-link:focus-visible {
        color: var(--accent);
    }

    .entry-link:focus-visible {
        outline: 0.125rem solid var(--accent);
        outline-offset: 0.125rem;
    }

    .entry-description {
        font-size: var(--font-size-18);
        color: var(--foreground-muted);
        line-height: 1.6;
    }

    @container (width <= 40rem) {
        .entry {
            flex-direction: column;
        }

        .entry-thumbnail {
            inline-size: 100%;
            block-size: auto;
            max-block-size: 8rem;
        }
    }
</style>
