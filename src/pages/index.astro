---
import Layout from "../layouts/Layout.astro";
import Grid from "../ui/Grid.astro";
import GridRules from "../ui/GridRules.astro";
import Section from "../ui/Section.astro";
import Row from "../ui/Row.astro";
import Cell from "../ui/Cell.astro";
import typography from "../styles/typography.module.css";
import githubLogo from "../images/github-logo.svg?raw";
import linkedinLogo from "../images/linkedin-logo.svg?raw";
import xLogo from "../images/x-logo.svg?raw";
import blueskyLogo from "../images/bluesky-logo.svg?raw";

const timeline = [
    {
        number: "01",
        year: "2026",
        month: "Feb",
        title: "Hosted the first official Astro Japan Meetup",
    },
    {
        number: "02",
        year: "2025",
        month: "Nov",
        title: "Founded Astro Japan Community as the official chapter",
    },
    {
        number: "03",
        year: "2025",
        month: "Oct",
        title: "Appointed as an official Maintainer for Astro",
    },
    {
        number: "04",
        year: "2024",
        month: "Sep",
        title: "Joined Plaid, Inc. and led Astro migration",
    },
];
---

<Layout title="Portfolio | Kenji">
    <Grid>
        <GridRules />
        <Section>
            <Cell start={1} span={5} smallSpan={4}>
                <h1 class:list={["introduction-title", typography.heroTitle]}>
                    Make the <span class="introduction-title__highlight">Web</span> quieter
                </h1>
                <p class:list={["introduction-role", typography.linkText]}>I'm Kenji　Wu</p>
            </Cell>
            <Cell start={7} span={2} smallStart={1} smallSpan={4}>
                <ul class="introduction-links">
                    <li>
                        <a
                            href="https://github.com/jp-knj"
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={["introduction-link", typography.metaText]}
                        >
                            <Fragment set:html={githubLogo} />
                            <span>GitHub</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://www.linkedin.com/in/kenji-tomita-10103b210/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={["introduction-link", typography.metaText]}
                        >
                            <Fragment set:html={linkedinLogo} />
                            <span>LinkedIn</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://x.com/jp_knj"
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={["introduction-link", typography.metaText]}
                        >
                            <Fragment set:html={xLogo} />
                            <span>Twitter</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://bsky.app/profile/jp-knj.bsky.social"
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={["introduction-link", typography.metaText]}
                        >
                            <Fragment set:html={blueskyLogo} />
                            <span>Bluesky</span>
                        </a>
                    </li>
                </ul>
            </Cell>
        </Section>

        <Section>
            <Cell start={1} span={3} smallSpan={4}>
                <h2 class:list={["lede", typography.bodyText]}>
                    Open source work, focused on Astro.
                </h2>
            </Cell>
            <Cell start={5} span={4} smallSpan={4}>
                <p class:list={["body", typography.linkText]}>
                    Maintainer for Astro, mostly the compiler and
                    internationalization.
                </p>
                <p class:list={["body", typography.linkText]}>
                    Organize Astro Japan, a local chapter that hosts in-person
                    meetups in Tokyo.
                </p>
            </Cell>
        </Section>

        {
            timeline.map((item) => (
                <Row>
                    <Cell start={1} span={1} smallSpan={1} />
                    <Cell start={2} span={5} smallStart={2} smallSpan={3}>
                        <span class:list={["entry-title", typography.cardTitle]}>
                            {item.title}
                        </span>
                    </Cell>
                    <Cell start={7} span={2} smallSpan={4}>
                        <span class:list={["entry-year", typography.metaText]}>
                            {item.month} · {item.year}
                        </span>
                    </Cell>
                </Row>
            ))
        }
    </Grid>
</Layout>

<style>
    .introduction-title {
        font-family: Syne, sans-serif;
        font-weight: 700;
        line-height: 0.95;
        color: var(--foreground);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .introduction-title__highlight {
        background: linear-gradient(
            to top,
            transparent 0,
            transparent 30%,
            #ff7a1a 30%,
            #ff7a1a 55%,
            transparent 55%
        );
        box-decoration-break: clone;
        padding: 0 0.04em;
    }

    .introduction-role {
        font-family: Syne, sans-serif;
        font-weight: 400;
        color: var(--foreground-secondary);
        line-height: 1.15;
        margin: clamp(0.75rem, 1.4vw, 1.25rem) 0 0;
        letter-spacing: -0.01em;
    }

    .introduction-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: clamp(0.75rem, 0.8vw, 1rem);
        color: var(--foreground-muted);
    }

    .introduction-link {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        color: inherit;
        text-decoration: none;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: color 0.2s ease;
    }

    .introduction-link:hover,
    .introduction-link:focus-visible {
        color: var(--foreground);
    }

    .lede {
        color: var(--foreground-secondary);
        font-weight: 600;
        line-height: 1.4;
        margin: 0;
    }

    .lede::before {
        content: "";
        display: inline-block;
        inline-size: 1em;
        block-size: 1em;
        border-radius: 50%;
        background: #ff7a1a;
        margin-inline-end: 0.4em;
        vertical-align: -0.15em;
    }

    .body {
        color: var(--foreground-muted);
        line-height: 1.7;
        margin: 0 0 0.75rem;
    }

    .body:last-child {
        margin-block-end: 0;
    }

    .section-note {
        color: var(--foreground-muted);
        letter-spacing: 0.08em;
        opacity: 0.7;
        margin: 0;
    }

    .number {
        color: var(--accent);
        font-family: "DM Mono", monospace;
        letter-spacing: 0.1em;
    }

    .entry-title {
        color: var(--foreground-secondary);
        font-weight: 600;
        line-height: 1.45;
    }

    .entry-year {
        color: var(--foreground-muted);
        text-align: end;
        display: block;
        letter-spacing: 0.08em;
    }

    @container (width <= 40rem) {
        .introduction-links {
            align-items: flex-start;
            margin-block-start: 1.25rem;
        }

        .entry-year {
            text-align: start;
            margin-block-start: 0.375rem;
        }
    }
</style>
