---
import Layout from "../layouts/layout.astro";
import githubLogo from "../images/github-logo.svg?raw";
import linkedinLogo from "../images/linkedin-logo.svg?raw";
import xLogo from "../images/x-logo.svg?raw";
import blueskyLogo from "../images/bluesky-logo.svg?raw";
import Hero from "./_section/_hero.astro";
import Profile from "./_section/_profile.astro";
import Log from "./_section/_log.astro";
import Links from "./_section/_links.astro";
---

<Layout title="Portfolio | Kenji">
    <main class="main">
        <div class="main-inner">
            <div class="main-scroll">
                <Hero />
                <Profile />
                <Log />
                <Links />
            </div>
        </div>
    </main>
</Layout>
<style>
    .main {
        box-sizing: border-box;
        display: grid;
        grid-template-rows: minmax(0, 1fr);
        min-block-size: 0;
        padding-block: 1rem;
        padding-inline-end: 1rem;
        overflow: visible;
    }

    .main-inner {
        --section-gap: 3rem;
        --section-padding: 3rem;

        position: relative;
        box-sizing: border-box;
        block-size: 100%;
        min-block-size: 0;
        border: 1px solid black;
        border-start-end-radius: 0.5rem;
        border-end-end-radius: 0.5rem;
        border-inline-start: none;
        overflow: visible;
    }

    .main-scroll {
        --scrollbar-offset: 1rem;

        position: absolute;
        inset-block: 0;
        inset-inline: 0 calc(-1 * var(--scrollbar-offset));
        box-sizing: border-box;
        padding-inline-end: var(--scrollbar-offset);
        overflow: hidden auto;
        scrollbar-color: var(--color-ink) var(--color-paper);
    }

    .main-scroll::-webkit-scrollbar {
        /* stylelint-disable-next-line csstools/use-logical -- WebKit scrollbar uses physical dimensions. */
        width: 1rem;
    }

    .main-scroll::-webkit-scrollbar-track {
        background: var(--color-paper);
    }

    .main-scroll::-webkit-scrollbar-thumb {
        background: var(--color-ink);
        border: 0.1875rem solid var(--color-paper);
        border-radius: 999rem;
    }

    .main-scroll::-webkit-scrollbar-thumb:hover {
        background: var(--color-green);
    }
</style>
